# Keep local secrets in .env.local at the repository root. Never commit a real
# .env file or use NEXT_PUBLIC_ for a secret.

# Copy both keys from the same Clerk development instance. These values are blank
# intentionally. The publishable key is public; the secret key stays server-only.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Exact application origin for Clerk's authorizedParties check (no trailing slash).
# Defaults to http://localhost:3000; set explicitly for another port or deployment.
# Live Clerk instances require HTTPS.
APP_ORIGIN=http://localhost:3000

# PostgreSQL is server-only. Use the dedicated local role and database; percent-
# encode reserved password characters. Never use the postgres administrator role.
# Example only: postgresql://afcs_dev:REPLACE_ME@localhost:5432/afcs_dev
DATABASE_URL=
